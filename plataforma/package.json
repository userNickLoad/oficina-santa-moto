    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "install": "^0.13.0",
    "npm": "^12.2.1",
    "pg": "^8.23.1",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/basil": "^1.2.4",
    "@tailwindcss/cli": "^4.3.3",
    "@types/argon2": "^0.14.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/redis": "^4.0.10",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
