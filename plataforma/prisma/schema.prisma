generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model atributo {
  id               Int                @id @default(autoincrement())
  id_categoria     Int
  nome             String             @db.VarChar(20)
  obrigatorio      Boolean
  numerico         Boolean            @default(false)
  categoria        categoria          @relation(fields: [id_categoria], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produto_atributo produto_atributo[]

  @@index([nome], map: "idx_atributo_nome")
}

model categoria {
  id        Int        @id @default(autoincrement())
  nome      String     @unique @db.VarChar(50)
  descricao String?    @db.VarChar(250)
  atributo  atributo[]
  produto   produto[]
}

model cliente {
  id       Int       @id @default(autoincrement())
  nome     String    @unique @db.VarChar(100)
  telefone String?   @db.VarChar(14)
  email    String?   @db.VarChar(100)
  servico  servico[]
  veiculo  veiculo[]
  venda    venda[]
}

model compra {
  id             Int              @id @default(autoincrement())
  id_usuario     Int
  id_fornecedor  Int?
  data           DateTime         @db.Timestamptz(6)
  fornecedor     fornecedor?      @relation(fields: [id_fornecedor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario        usuario          @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produto_compra produto_compra[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model estante {
  id                Int            @id @default(autoincrement())
  id_modelo_estante Int
  id_local          Int
  linha             Int
  coluna            Int
  local             local          @relation(fields: [id_local], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modelo_estante    modelo_estante @relation(fields: [id_modelo_estante], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prateleira        prateleira[]

  @@unique([id_local, linha, coluna], map: "uq_estante_local_posisao")
}

model fornecedor {
  id        Int      @id @default(autoincrement())
  nome      String   @unique @db.VarChar(100)
  telefone  String?  @db.VarChar(14)
  link_site String?  @db.VarChar(250)
  email     String?  @db.VarChar(100)
  descricao String?  @db.VarChar(500)
  compra    compra[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model local {
  id          Int       @id @default(autoincrement())
  id_local    Int?
  nome        String    @db.VarChar(20)
  linha       Int?
  coluna      Int?
  linhas      Int       @default(1)
  colunas     Int       @default(1)
  estante     estante[]
  local       local?    @relation("localTolocal", fields: [id_local], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_local local[]   @relation("localTolocal")

  @@unique([id_local, linha, coluna], map: "uq_local_posicao")
}

model marca {
  id      Int       @id @default(autoincrement())
  nome    String    @unique @db.VarChar(100)
  imagem  String?
  modelo  modelo[]
  produto produto[]
}

model modelo {
  id       Int       @id @default(autoincrement())
  nome     String    @db.VarChar(20)
  id_marca Int
  marca    marca     @relation(fields: [id_marca], references: [id], onDelete: NoAction, onUpdate: NoAction)
  veiculo  veiculo[]

  @@unique([id_marca, nome])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model modelo_estante {
  id                               Int                                @id @default(autoincrement())
  nome                             String                             @unique @db.VarChar(20)
  qtd_colunas                      Int                                @default(1)
  qtd_linhas                       Int                                @default(1)
  estante                          estante[]
  modelo_prateleira_modelo_estante modelo_prateleira_modelo_estante[]
}

model modelo_prateleira {
  id                               Int                                @id @default(autoincrement())
  nome                             String                             @unique @db.VarChar(20)
  comprimento                      Int?                               @default(10)
  largura                          Int?                               @default(10)
  altura                           Int?                               @default(10)
  modelo_prateleira_modelo_estante modelo_prateleira_modelo_estante[]
  prateleira                       prateleira[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model modelo_prateleira_modelo_estante {
  id                   Int               @id @default(autoincrement())
  id_modelo_prateleira Int
  id_modelo_estante    Int
  coluna               Int
  linha                Int
  modelo_estante       modelo_estante    @relation(fields: [id_modelo_estante], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modelo_prateleira    modelo_prateleira @relation(fields: [id_modelo_prateleira], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_modelo_estante, coluna, linha], map: "uq_modelo_prateleira_modelo_estante_posicao")
}

model permissao {
  id                Int                 @id @default(autoincrement())
  nome              String              @unique @db.VarChar(100)
  permissao_caminho permissao_caminho[]
  usuario_permissao usuario_permissao[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model prateleira {
  id                   Int                  @id @default(autoincrement())
  id_estante           Int
  id_modelo_prateleira Int
  linha                Int
  coluna               Int
  estante              estante              @relation(fields: [id_estante], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modelo_prateleira    modelo_prateleira    @relation(fields: [id_modelo_prateleira], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produto_prateleira   produto_prateleira[]

  @@unique([id_estante, linha, coluna], map: "uq_prateleira_estante_local_posisao")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model produto {
  id                 Int                  @id @default(autoincrement())
  nome               String               @db.VarChar(100)
  preco_venda        Decimal              @db.Decimal(10, 2)
  qtd_disponivel     Int                  @default(0)
  codigo_barras      String?
  descricao          String?
  alerta_quantidade  Int?                 @default(0)
  comprimento        Int?                 @default(10)
  largura            Int?                 @default(10)
  altura             Int?                 @default(10)
  id_categoria       Int?
  id_marca           Int?
  categoria          categoria?           @relation(fields: [id_categoria], references: [id], onDelete: NoAction, onUpdate: NoAction)
  marca              marca?               @relation(fields: [id_marca], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produto_atributo   produto_atributo[]
  produto_compra     produto_compra[]
  produto_imagem     produto_imagem[]
  produto_prateleira produto_prateleira[]
  venda_produto      venda_produto[]

  @@index([id_categoria], map: "idx_produto_id_categoria")
  @@index([id_marca], map: "idx_produto_id_marca")
  @@index([nome], map: "idx_produto_nome")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model produto_atributo {
  id_produto     Int
  id_atributo    Int
  valor_texto    String?
  valor_numerico Decimal? @db.Decimal
  atributo       atributo @relation(fields: [id_atributo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produto        produto  @relation(fields: [id_produto], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_atributo, id_produto])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model produto_compra {
  id_produto   Int
  id_compra    Int
  preco_compra Decimal @db.Decimal(10, 2)
  qtd_comprado Int     @default(0)
  compra       compra  @relation(fields: [id_compra], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produto      produto @relation(fields: [id_produto], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_produto, id_compra])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model produto_prateleira {
  id_produto    Int
  id_prateleira Int
  quantidade    Int
  prateleira    prateleira @relation(fields: [id_prateleira], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produto       produto    @relation(fields: [id_produto], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_produto, id_prateleira])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model servico {
  id             Int      @id @default(autoincrement())
  descricao      String?
  preco_mao_obra Decimal  @db.Decimal(10, 2)
  preco_total    Decimal  @db.Decimal(10, 2)
  id_venda       Int?
  id_cliente     Int?
  id_veiculo     Int?
  status         String?  @default("EM_ANDAMENTO") @db.VarChar(30)
  cliente        cliente? @relation(fields: [id_cliente], references: [id], onDelete: NoAction, onUpdate: NoAction)
  veiculo        veiculo? @relation(fields: [id_veiculo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venda          venda?   @relation(fields: [id_venda], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model usuario {
  id                Int                 @id @default(autoincrement())
  nome              String              @unique @db.VarChar(100)
  senha             String
  email             String?             @db.VarChar(100)
  telefone          String?             @db.VarChar(14)
  ativo             Boolean?            @default(false)
  compra            compra[]
  usuario_permissao usuario_permissao[]
  venda             venda[]
}

model usuario_permissao {
  id_usuario   Int
  id_permissao Int
  permissao    permissao @relation(fields: [id_permissao], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario      usuario   @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_usuario, id_permissao])
}

model veiculo {
  id         Int       @id @default(autoincrement())
  ano        Int
  id_modelo  Int
  id_cliente Int?
  servico    servico[]
  cliente    cliente?  @relation(fields: [id_cliente], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modelo     modelo    @relation(fields: [id_modelo], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model venda {
  id            Int             @id @default(autoincrement())
  data          DateTime        @db.Timestamptz(6)
  preco_total   Decimal         @db.Decimal(10, 2)
  id_usuario    Int
  id_cliente    Int?
  servico       servico[]
  cliente       cliente?        @relation(fields: [id_cliente], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario       usuario         @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venda_produto venda_produto[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model venda_produto {
  id_venda       Int
  id_produto     Int
  quantidade     Int
  preco          Decimal @db.Decimal(10, 2)
  preco_original Decimal @db.Decimal(10, 2)
  produto        produto @relation(fields: [id_produto], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venda          venda   @relation(fields: [id_venda], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_venda, id_produto])
}

model caminho {
  id                Int                 @id @default(autoincrement())
  path              String              @unique
  permissao_caminho permissao_caminho[]
}

model permissao_caminho {
  id_permissao Int
  id_caminho   Int
  caminho      caminho   @relation(fields: [id_caminho], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permissao    permissao @relation(fields: [id_permissao], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_caminho, id_permissao])
  @@index([id_permissao], map: "idx_id_permissao")
}

model imagem {
  id             Int             @id @default(autoincrement())
  caminho        String?
  produto_imagem produto_imagem?
}

model produto_imagem {
  id_produto Int
  id_imagem  Int     @unique
  imagem     imagem  @relation(fields: [id_imagem], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produto    produto @relation(fields: [id_produto], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_produto, id_imagem])
}
