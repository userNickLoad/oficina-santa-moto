<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/output.css">
    <title><%= title %> - Santa Moto</title>
</head>
<body class="w-[100vw] overflow-x-hidden">
    <a href="#principal" class="w-screen text-center absolute focus:top-0 top-[-100px]">
        <p class="py-[1vh] px-[1vw] bg-white">
            Enter para conteúdo principal da página
        </p>
    </a>
    <%- include("../partials/header") %>
    <main id="principal" class="min-h-[80vh] flex flex-col md:px-[5vw] px-[2vw]">
        
        <%- include( content ) %>
    </main>
    

    <%- include("../partials/footer") %>
</body>
</html>