<%
    const {
        type = "submit",
        name = "",
        id = name,
        content = name,
        onclick = "",
        href = "#",
        css = "",
        size = "w-full",
        svg = null,
        submit = false
    } = button;

    const click = typeof onclick !== "undefined" ? onclick : "";
%>

<%if(type == "submit" && svg != null){%>
    <button
        onclick="<%= click %>"
        type="<%= (submit)? "submit": "button" %>"
        id="<%= id %>"
        name="<%= name %>"
        alt="<%= content %>"
        class="flex h-auto w-full items-center justify-center gap-[1vw] bg-primary px-[2vw] py-[.5vh] rounded-full hover:scale-105 ease-in-out duration-75"
    >
    <%const svg_path = `../svg/${svg.path}`%>
    <%- include(svg_path, { svg }) %>
    <p><%= content %></p>
    </button>
<%} else if(type == "submit"){%>
    <button
        onclick="<%= click %>"
        type="<%= (submit)? "submit": "button" %>"
        id="<%= id %>"
        name="<%= name %>"
        alt="<%= content %>"
        class="xl:px-[2vw] py-[1vh] px-[20vw] bg-primary rounded-2xl cursor-pointer hover:opacity-95 lg:text-3xl text-4xl hover:scale-105 ease-in-out duration-75""
    >
    <%= content %>
    </button>
<%} else if(type == "simple"){%>

    <button 
        onclick="<%= click %>"
        type="<%= (submit)? "submit": "button" %>"
        id="<%= id %>"
        name="<%= name %>"
        alt="<%= content %>"
        class="flex h-auto items-center justify-center gap-[1vw] 
            border border-gray-400 px-[2vw] py-[.5vh] rounded-full <%= css %> <%= size %>
            hover:scale-105 ease-in-out duration-75"
    >
        <p class="font-bold"><%= content %></p>
    </button>

<% } else if(type == "href"){%>

    <a 
        onclick="<%= click %>"
        type="<%= (submit)? "submit": "button" %>"
        id="<%= id %>"
        name="<%= name %>"
        alt="<%= content %>"
        href="<%= href %>""
        class="flex h-auto items-center justify-center gap-[1vw] 
        border border-gray-400 px-[2vw] py-[.5vh] rounded-full <%= css %> <%= size %>
        hover:scale-105 ease-in-out duration-75"
    >
        <p class="font-bold"><%= content %></p>
    </a>

<% } %>
