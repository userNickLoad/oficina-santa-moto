<a  
    href=<%= href %>
    class="flex flex-col justify-center items-center gap-[2vh]"
    >
    <div
        class="xl:w-[20vh] xl:h-[20vh] w-[15vh] h-[15vh] flex justify-center items-center bg-primary rounded-4xl"
        >
        <img tabindex="-1" src=<%= src %> alt=<%= name %>  class="w-[90%] h-[90%]">
    </div>
    <h2 class="text-center lg:text-3xl">
        <%= name %>
    </h3>
</a>