<a  
    href=<%= href %>
    class="flex flex-col justify-center items-center gap-[2vh]"
    >
    <div
        class="w-[20vh] h-[20vh] flex justify-center items-center bg-primary rounded-4xl"
        >
        <img tabindex="-1" src=<%= src %> alt=<%= name %>  class="w-[90%] h-[90%]">
    </div>
    <h3 class="text-center">
        <%= name %>
    </h3>
</a>