<%
    const {
        id,
        title,
        name = null,
        text_size = "text-2xl",
        column = false,
        size = "w-full",
        type = "text",
        maxlength = "50",
        placeholder = "",
        mask = null,
        rows = "5"
    } = item;
    const id_applay = name.toLowerCase();
    const column_applay = (column)? "justify-center py-[1vh]": "flex-col";

    const name_input = (name == null)? id: name;

%>

<div class="<%= size %> flex <%= column_applay %> gap-[2vh]">
    <label class="<%= text_size %> flex items-center" for="<%= item.name %>">
        <%= title %>
    </label>
    <% if(type == "textarea") { %>
        <textarea 
            name="<%= name %>" 
            id="<%= id_applay %>"
            placeholder="<%= placeholder %>",
            rows="<%= rows %>"
            maxlength="<%= maxlength %>"
            class="border resize-none h-32 p-3 border-gray-200  rounded-2xl focus:outline-2 focus:outline-gray-400 <%= text_size %>"
            ></textarea>
    <% } else if (type == "image"){ %>
        <div
            class="flex flex-col w-full"
        >
                <input 
                type="file" 
                name="<%= name %>" 
                id="<%= id_applay %>"
                accept="image/png, image/jpeg, image/webp"
                placeholder=<%= placeholder %>
                class=" border  border-gray-200 lg:px-[1vw] px-[3vw] rounded-2xl focus:outline-2 focus:outline-gray-400 <%= text_size %>"
                >

                <div
                    class="w-full flex justify-center mt-[1vh]"
                >
                    <%- include("./button", { button: {
                        type: "simple",
                        id: `cancel-${id}` ,
                        name: `cancel-${name}`,
                        content: "cancelar envio",
                        size: "w-auto px-[2vw]"
                    }}) %>
                </div>
        </div>

        <p class="text-red-900 min-h-[3vh]" id="<%= item.id %>Output"></p>
    <% } else { %>
            <input
            
                class=" border  border-gray-200 lg:px-[1vw] px-[3vw] rounded-2xl focus:outline-2 focus:outline-gray-400 <%= text_size %>"
                type="<%= type%>"
                id="<%= name %>"
                name="<%= name_input %>"
                alt="escreva <%= name %>"
                maxlength=<%= maxlength %>
                placeholder="<%= placeholder %>"
                    <% if (mask === "currency") { %>
                        data-mask="currency"
                        inputmode="numeric"
                    <% } %>
            >
            <p class="text-red-900 min-h-[3vh]" id="<%= item.id %>Output"></p>
        <% } %>
</div>
