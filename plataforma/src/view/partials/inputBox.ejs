<%
    const id = item.name.toLowerCase();
    const text_size = (item.text_size)? item.text_size: "text-2xl";
%>

<div class="xl:w-[50%] w-full flex flex-col">
    <label class="<%= text_size %>" for="<%= item.name %>">
        <%= item.name %>
    </label>

    <input
       
        class=" border  border-gray-200 mt-[1vh] lg:px-[1vw] px-[3vw] rounded-2xl focus:outline-2 focus:outline-gray-400 <%= text_size %>"
        type="<%= item.type %>"
        id="<%= item.name %>"
        name="<%= id %>"
        alt="escreva <%= item.name %>"
        maxlength=<%= item.maxlength %>
        placeholder="<%= item.placeholder %>"
    >
    <p class="text-red-900 min-h-[3vh]" id="<%= item.name %>Output"></p>
</div>