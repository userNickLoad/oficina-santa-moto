
<%
    const {
        id,
        title,
        name = null,
        text_size = "text-md",
        column = false,
        size = "w-full",
        type = "text",
        maxlength = "50",
        placeholder = "",
        mask = null,
        rows = "5",
        radios = [],
        max_number = "",
        value = null,
        step = "1",
        output = null,
        subtitte = null,
        valueHidden = null
    } = item;

    const name_input = name ?? id;
    const id_applay = String(name_input).toLowerCase();
    const column_applay = column
        ? "flex-row items-center"
        : "flex-col";

    const input_class = `
        w-full border border-gray-200 rounded-xl
        px-3 py-3
        focus:outline-none focus:ring-2 focus:ring-gray-400
        transition-all duration-200
        ${text_size}
    `;
%>

<div
    class="<%= size %> flex <%= column_applay %> gap-2"
    data-parent="inputbox"
>
    <% if (title) { %>
        <label
            class="<%= text_size %> font-medium flex items-center"
            for="<%= type === 'search' ? `search-input-${id}` : id_applay %>"
        >
            <%- title %>
        </label>
    <% } %>

    <% if (subtitte) { %>
        <p class="text-sm text-gray-500">
            <%= subtitte %>
        </p>
    <% } %>

    <% if (type === "textarea") { %>

        <textarea
            name="<%= name_input %>"
            id="<%= id_applay %>"
            placeholder="<%= placeholder %>"
            rows="<%= rows %>"
            maxlength="<%= maxlength %>"
            class="<%= input_class %> resize-none min-h-32"
        ><%= value ?? '' %></textarea>

    <% } else if (type === "radio") { %>

        <div class="w-full flex flex-col gap-3">
            <% radios.forEach(function(radio) { %>
                <label
                    for="radio-<%= id_applay %>-<%= radio %>"
                    class="flex items-center gap-3 cursor-pointer"
                >
                    <input
                        type="radio"
                        name="<%= name_input %>"
                        id="radio-<%= id_applay %>-<%= radio %>"
                        value="<%= radio %>"
                        class="w-5 h-5 accent-primary"
                    >

                    <span><%= radio %></span>
                </label>
            <% }); %>
        </div>

    <% } else if (type === "check") { %>

        <div class="w-full flex items-center gap-3">
            <input
                type="checkbox"
                name="<%= name_input %>"
                id="<%= id_applay %>"
                class="w-5 h-5 accent-primary"
                <%= value ? "checked" : "" %>
            >
        </div>

    <% } else if (type === "image") { %>

        <div class="flex flex-col w-full gap-3">

            <input
                type="file"
                name="<%= name_input %>[]"
                id="<%= id_applay %>"
                accept="image/png, image/jpeg, image/webp"
                multiple
                class="hidden"
            >

            <label
                for="<%= id_applay %>"
                class="
                    flex items-center justify-center gap-2
                    w-full px-4 py-3
                    bg-primary rounded-xl
                    font-semibold
                    cursor-pointer
                    hover:opacity-90
                    transition-all duration-200
                "
            >
                <span>Selecionar imagens</span>
            </label>

            <div
                id="<%= id_applay %>-preview"
                class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3"
            ></div>

            <div class="flex justify-center">
                <%- include("./button", { button: {
                    type: "simple",
                    id: `cancel-${id_applay}`,
                    name: `cancel-${name_input}`,
                    content: "Cancelar envio",
                    size: "w-auto px-6"
                }}) %>
            </div>

        </div>

    <% } else if (type === "search") { %>

        <div
            class="relative w-full"
            data-pai="searchBar"
            data-input=""
            id="search-<%= id %>"
        >
            <div class="relative w-full z-10">

                <input
                    id="search-hidden-<%= id %>"
                    name="<%= name_input %>Id"
                    type="hidden"
                    value="<%= valueHidden ?? '' %>"
                >

                <button
                    id="btn-search-<%= id %>"
                    type="button"
                    class="absolute left-2 top-1/2 -translate-y-1/2 hidden"
                >
                    <img
                        src="/assets/searchIcon.png"
                        alt="Ícone de pesquisa"
                        class="w-5 h-5"
                    >
                </button>

                <input
                    id="search-input-<%= id %>"
                    type="text"
                    name="<%= name_input %>"
                    placeholder="<%= placeholder %>"
                    maxlength="<%= maxlength %>"
                    autocomplete="off"
                    class="<%= input_class %>"
                    value="<%= value ?? '' %>"

                >

            </div>

            <div
                id="search-autocomplete-<%= id %>"
                class="
                    absolute top-full left-0
                    translate-y-2
                    w-full
                    h-0
                    flex
                    overflow-y-hidden
                    transition-all duration-200
                    z-20
                "
            >
                <ul
                    id="search-placement-<%= id %>"
                    class="
                        w-full flex flex-col
                        bg-white
                        border border-gray-200
                        rounded-xl
                        shadow-lg
                        divide-y divide-gray-100
                        overflow-hidden
                    "
                >
                    <li
                        id="search-default-<%= id %>"
                        class="
                            w-full px-4 py-3
                            items-center
                            cursor-pointer
                            hover:bg-gray-100
                            transition-colors
                            hidden
                        "
                    >
                        Opção
                    </li>
                </ul>
            </div>
        </div>

    <% } else { %>

        <input
            class="<%= input_class %>"
            type="<%= type %>"
            id="<%= id_applay %>"
            name="<%= name_input %>"
            alt="Escreva <%= name_input %>"
            maxlength="<%= maxlength %>"
            placeholder="<%= placeholder %>"
            <% if (mask === "currency") { %>
                data-mask="currency"
                inputmode="numeric"
            <% } else if (mask === "phone") { %>
                data-mask="phone"
                inputmode="numeric"
            <% } %>
            <% if (type === "number") { %>
                max="<%= max_number %>"
                step="<%= step %>"
            <% } %>
            <% if (value !== null && value !== undefined) { %>
                value="<%= value %>"
            <% } %>
        >

    <% } %>

    <p
        class="text-red-900 text-sm min-h-[2vh]"
        id="output-<%= id_applay %>"
    >
        <% if (output) { %>
            <span class="text-gray-500">
                <%= output %>
            </span>
        <% } %>
    </p>
</div>
