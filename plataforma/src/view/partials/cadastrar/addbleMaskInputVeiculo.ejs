<%
    const {id, elements = []} = mask

%>

<div
    class="w-full flex flex-col relative items-center p-[1vh] border border-gray-400 rounded-2xl"
    >
    <button
        id="remove-<%= id %>"
        type="button"
        class="w-[4vh] h-[4vh] rounded-lg bg-red-900 text-white
        hover:scale-10S5 transition-transform duration-300 hover:z-10
        hover:bg-red-500
        font-bold text-3xl flex justify-center items-center
        leading-none p-0
        absolute self-end"
        >
        <span class="">−</span>
    </button>

    <div
        class="flex flex-col w-[90%]"
        >
        <% elements.forEach(element => {%>
            <%- include("./inputs", {
                element
            })%>
        <% }) %>
    </div>

</div>
