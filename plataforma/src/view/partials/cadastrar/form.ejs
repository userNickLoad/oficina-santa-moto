<% 
    const {
        action,
        method = "get",
        id,
        elements,
        buttons,
        submit,
        size = "lg:w-[50vw] w-full",
        gap = "gap-[2vh]"
    } = form;    
%>

<form 
    action="<%= action %>" 
    method="<%= method %>" 
    id="<%= id %>"
    class="flex flex-col items-center <%= size %> <%= gap %>"
>

    <% form.elements.forEach(element => {%>
        <%- include("./inputs", { element })%>
    <% }); %>

    <p id="error" class="h-[2vh] text-red-900 min-h-[3vh]"></p>
    
    <div class="flex flex-col gap-[5vh] mt-[5vh]">

        <% buttons.forEach((element) => { %>
            <%- include('./inputs', { element: {type: "button", button: element} }) %>
        <% }); %>

    </div>
    
</form>