<form 
    action="<%= form.action %>" 
    method="<%= form.method %>" 
    id="<%= form.id %>"
    class="flex flex-col items-center lg:w-[50vw] w-full"
>

    <% form.elements.forEach(element => {%>
        <%- include("./inputs", { element })%>
    <% }); %>
    
    <div class="flex flex-col gap-[5vh] mt-[5vh]">
        <button 
            type="submit"
            class="flex h-auto w-full items-center justify-center gap-[1vw] bg-primary px-[2vw] py-[.5vh] rounded-full "
        >
            <svg 
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="h-6 w-6 shrink-0"
            >
                <path
                    fill="#ffff"
                    d="M5 21h14a2 2 0 0 0 2-2V8a1 1 0 0 0-.29-.71l-4-4A1 1 0 0 0 16 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2m10-2H9v-5h6zM13 7h-2V5h2zM5 5h2v4h8V5h.59L19 8.41V19h-2v-5a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2v5H5z"
                />
            </svg>

            <p class="font-bold">Salvar produto</p>
        </button>

        <%- include("../button", {button: {
            type: "simple",
            id: "clear",
            name: "clear",
            content: "Limpar campos"
        }}) %>
    </div>
    
</form>