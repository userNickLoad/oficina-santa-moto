<!-- 
    type: container
    flex_col: opcional -> direção do flex
    gap: opcional -> gap 
    class: opcional -> classes tailwind
    name: opcional -> p com o nome da sessão
    elements: obrigatorio -> elementos internos

-->

<% 
    const {
        id,
        flex = "",
        gap = "",
        css = null,
        title = null,
        elements = []
    } = container;

    const classCss = (css)? container.class: `flex ${flex} w-full ${gap} justify-around items-center`;

%>

<%if(title != null){%>
    <p class="text-lg ">
        <%= title %>
    </p>
<% } %>

<div
    id="addble-container-<%= id %>"
    class="flex flex-col gap-[2vh] <%= classCss %> "
    >

    <div 
        id="addble-element-<%= id %>"
        class="w-full gap-[1vw] hidden"
        >

        <div
            class="flex flex-col flex-1 border border-gray-400 p-[1vh] rounded-2xl "
            >
            <% elements.forEach((element) => { %>
                    <%- include("./inputs", {element} ) %>  
            <% }); %>
          
        </div> 

        <div
            class="flex justify-end items-center"
            >
            <button
                id="remove-<%= id %>"
                type="button"
                class="w-[4vh] h-[4vh] rounded-lg bg-red-900 text-white
                hover:scale-105 transition-transform duration-300 hover:z-10
                hover:bg-red-500
                font-bold text-3xl flex justify-center items-center
                leading-none p-0"
            >
                <span class="">−</span>
            </button>
        </div>

    </div>
    
    <div
        class="w-full flex justify-center"
    >
        <%- include("../button", {button: {
            id: `add-new-${id}`,
            type: "simple",
            content: "adicionar",
            size: "w-auto px-[1vw]"
        }}) %>
    </div>
</div>