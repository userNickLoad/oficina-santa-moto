<!-- 
    type: container
    flex_col: opcional -> direção do flex
    gap: opcional -> gap 
    class: opcional -> classes tailwind
    name: opcional -> p com o nome da sessão
    elements: obrigatorio -> elementos internos

-->

<% 
    const {
        id,
        flex = "",
        gap = "",
        css = null,
        title = null,
        mask = "./addbleMask",
        elements = []
    } = container;

    const classCss = (css)? container.class: `flex ${flex} w-full ${gap} justify-around items-center`;

%>

<%if(title != null){%>
    <p class="text-lg ">
        <%= title %>
    </p>
<% } %>

<div
    id="addble-container-<%= id %>"
    class="flex flex-col gap-[2vh] w-full"
    data-parent="addblebox"
    >
    <div
        id="addble-placement-<%= id %>"
        class="w-full flex flex-col gap-[1vh] "
        >
        <div 
            id="addble-element-<%= id %>"
            class="w-full hidden  <%= classCss %> "
            >
                
            <%- include(mask, {mask: {id, elements}}) %>

        
        </div>

    </div>
    
    <div
        class="w-full flex justify-center"
    >
        <%- include("../button", {button: {
            id: `add-new-${id}`,
            type: "simple",
            content: "adicionar",
            size: "w-auto px-[1vw]"
        }}) %>
    </div>
</div>