
<% if(element.type == "input") {%>
    <% console.log(element.input, element.type == "input"); const item = element.input %>
    <%- include("../inputBox", {
        item
    }) %>

<% } else if(element.type == "hidden_container") {%>
    <%- include("./hidden_container", {container: element.container}) %>
<% } else if(element.type == "container") { %>
    <%- include("./container", {container: element.container}) %>
<% } else if(element.type == "direct") { %>
    <%- include("./container", {container: element.container}) %>
<% } else if(element.type == "button") { %>
    <%- include("../button", {button: element.button}) %>
<% } %>
