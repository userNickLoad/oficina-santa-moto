<% 
    const {
        title = null,
        elements,
        gap = "gap-[2vh]",
        description = null
    } = container;
    const first = elements.shift(); 

%>

<div
    id="container-h-<%= container.id %>"
    data-open="false"
    class="flex flex-col w-full items-center <%= gap %> "
    >

    <div 
        class="w-full"
    >
        <%if(title){%>
            <p
                class="w-full text-center <%= (typeof title === "string")? "": title.text_size %>"
            >   
                <%= (typeof title === "string")? title: title.text %>
            </p>
        <% } %>
        <% if(description) {%>
            <p
                class="w-full"
            >
                description
            </p>
        <% } %>
    </div>


    <%- include("./inputs", {element: first }) %>
    
    <div
        id="hidden-container-<%= container.id %>"
        class="items-center h-0 overflow-y-hidden"
        >
        <% elements.forEach(element => { %>
            <%- include("./inputs", {element: element }) %>
        <% }); %>
    </div>


</div>