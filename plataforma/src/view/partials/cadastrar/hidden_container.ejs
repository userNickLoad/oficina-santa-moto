<% 
    const {
        title = null,
        elements,
        gap = "gap-[2vh]",
        description = null
    } = container;
    const first = elements.shift(); 

%>

<div
    id="container-h-<%= container.id %>"
    data-open="false"
    class="flex flex-col w-full items-center <%= gap %> "
    >

    <div 
        class="flex flex-col w-full gap-[.5vh]"
    >
        <%if(title){%>
            <p
                class="w-full text-center <%= (typeof title === "string")? "text-lg": title.text_size %>"
            >   
                <%= (typeof title === "string")? title: title.text %>
            </p>
        <% } %>
        <% if(description) {%>
            <p
                class="w-full text-sm text-gray-400 text-center"
            >
                <%= description %>
            </p>
        <% } %>
    </div>


    <%- include("./inputs", {element: first }) %>
    
    <div
        id="hidden-container-<%= container.id %>"
        class="w-full overflow-y-hidden h-0 transition-[height] duration-300 ease-in-out"
        >
        <div
            class="py-[1vh] w-full h-max px-[2vw] border border-gray-400 rounded-2xl mt-[1px]"
            >
            <% elements.forEach(element => { %>
                <%- include("./inputs", {element: element }) %>
            <% }); %>
        </div>
    </div>


</div>