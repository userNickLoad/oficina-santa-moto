<section class="relative mt-[2vh]">
    <h3 class="font-bold">Categorias</h3>

    <%- include("./button", {
        button: {
            id: "open-categories",
            text: "Todas as categorias",
            target: "categories-panel",
            fullWidth: true
        }
    }) %>

    <div
        id="categories-panel"
        class="filter-panel absolute z-20 mt-[1vh] w-full
        max-h-0 overflow-hidden bg-white rounded-xl
        transition-[max-height] duration-300 ease-out"
    >
        <div class="p-2">
            <% categories.forEach(category => { %>
                <%- include("./category", { category }) %>
            <% }); %>
        </div>
    </div>
</section>