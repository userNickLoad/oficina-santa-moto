<label
    for="value-<%= attributeId %>-<%= value.id %>"
    class="flex items-center gap-3 w-full p-2
    rounded-lg cursor-pointer hover:bg-gray-100"
>
    <input
        type="checkbox"
        id="value-<%= attributeId %>-<%= value.id %>"
        name="valores"
        value="<%= value.id %>"
        data-attribute-id="<%= attributeId %>"
        class="w-4 h-4 accent-orange-600"
    >

    <span class="text-sm">
        <%= value.nome %>
    </span>
</label>