
<header class="w-full h-[80px] sm:h-[10vh] min-h-[70px] flex items-center justify-between bg-primary px-4 sm:px-[5vw] relative">

    <nav class="flex items-center z-10 shrink-0">

        <% if (typeof voltar !== "undefined" && voltar) { %>
            <a
                href="<%= typeof voltarPara !== 'undefined' ? voltarPara : '/' %>"
                class="flex items-center justify-center"
                aria-label="Voltar"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-10 h-10 sm:w-12 sm:h-12"
                    viewBox="0 0 24 24"
                >
                    <path
                        fill="currentColor"
                        d="M20.446 16.06a.5.5 0 0 1-.655.68l-2.5-1.153a14.4 14.4 0 0 0-6.681-1.309a61 61 0 0 1-.121 2.204l-.069.938a.754.754 0 0 1-1.158.581a19.6 19.6 0 0 1-5.351-5.068l-.46-.64a.5.5 0 0 1 0-.584l.46-.64A19.6 19.6 0 0 1 9.262 6a.754.754 0 0 1 1.158.58l.069.94q.069.945.108 1.89h.644a9.5 9.5 0 0 1 8.475 5.209z"
                    />
                </svg>
            </a>
        <% } %>

    </nav>
   
    <h1 class="absolute left-1/2 -translate-x-1/2 text-secondary text-2xl sm:text-3xl lg:text-4xl font-extrabold text-center leading-tight w-[55%] sm:w-[60%] pointer-events-none">
        <%= title %>
    </h1>

    <a href="/" class="flex items-center justify-end z-10 shrink-0" aria-label="Voltar ao início">
        <img
            src="/assets/logo.png"
            alt="Logo Santa Moto"
            class="h-12 sm:h-16 w-auto object-contain"
        >
    </a>

</header>
