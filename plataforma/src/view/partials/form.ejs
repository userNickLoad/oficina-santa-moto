<form action="<%= action %>" method="<%= method %>" id="<%= id %>"
    class=" lg:w-[90vw] w-full flex flex-col justify-center align-middle items-center gap-[2vh]"
>
    <% items.forEach(item => {%>
        <%- include("../partials/inputBox", { item })%>
    <% }); %>

    <p id="error" class="h-[2vh] text-red-900 min-h-[3vh]"></p>

    <div class="w-full h-[8vh] flex justify-center">
        <%- include("../partials/button", {button: {
            name: "submit",
            id: "",
            content: "entrar"
        }}) %>

    </div>
</form>