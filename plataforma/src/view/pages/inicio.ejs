<% const ops=[
    {href: "/estoque" , src: "/assets/estoque.png" , name: "estoque" },
    {href: "/servicos" , src: "/assets/servicos.png" , name: "serviços" },
    {href: "/clientes" , src: "/assets/cliente.png" , name: "clientes" },
    {href: "/funcionarios" , src: "/assets/funcionarios.png" , name: "funcionarios" },
    {href: "/cadastrar-produto" , src: "/assets/cadastrar_rpodutos.png" , name: "Cadastrar produtos" },
    {href: "/vendas" , src: "/assets/vender.png", name: "Registrar venda" },    
    {href: "/usuairo/atualizar-cadastro" , src: "/assets/configuracoes.png" , name: "configurações" },
 ] %>

    <section class="flex flex-col justify-center items-center">
        <div class="flex mt-[2vh] w-full">
            <h2 class="border-b border-gray px-[1vw]">
                Bem vindo(a) <span class="text-primary">
                    <%= userName %>
                </span> </br>
                Selecione uma funcionalidade para continuar

            </h2>
        </div>
        <nav class="grid lg:grid-cols-5 grid-cols-2 gap-[2vw] my-[5vh]">
            <% ops.forEach(item=> {%>
                <%- include("../partials/card", item)%>
                    <% }); %>
        </nav>
        
    </section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const params = new URLSearchParams(window.location.search);
        const erro = params.get("erro");

        if (erro !== "sem-permissao") return;

        const toast = document.createElement("div");

        toast.className =
            "fixed top-5 right-5 z-50 max-w-sm rounded-xl " +
            "bg-red-100 border border-red-300 text-red-800 " +
            "px-5 py-4 shadow-lg";

        toast.textContent = "Você não tem permissão para acessar esta funcionalidade";
        toast.setAttribute("role", "alert");

        document.body.appendChild(toast);

        setTimeout(() => toast.remove(), 5000);

        window.history.replaceState({},"",window.location.pathname
        );
    });
</script>
