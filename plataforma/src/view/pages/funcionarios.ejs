<script>
    document.addEventListener("DOMContentLoaded", () => {
        const params = new URLSearchParams(window.location.search);
        const sucesso = params.get("sucesso");

        const mensagens = {
            cadastro: "✓ Funcionário cadastrado com sucesso",
            edicao: "✓ Funcionário atualizado com sucesso"
        };

        const mensagem = mensagens[sucesso];

        if (!mensagem) return;

        const toast = document.createElement("div");

        toast.className =
            "fixed top-5 right-5 z-50 max-w-sm rounded-xl " +
            "bg-green-100 border border-green-300 text-green-800 " +
            "px-5 py-4 shadow-lg";

        toast.textContent = mensagem;
        toast.setAttribute("role", "status");

        document.body.appendChild(toast);

        setTimeout(() => toast.remove(), 5000);

        window.history.replaceState(
            {},
            "",
            window.location.pathname
        );
    });
</script>

<%
    const { funcionarios = [] } = innerContent;
%>

<section class="w-full max-w-[1100px] mx-auto px-4 py-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">

        <div>
            <h1 class="text-2xl font-semibold text-gray-900">
                Funcionários
            </h1>

            <p class="text-gray-600 mt-1">
                Gerenciamento de funcionários cadastrados
            </p>
        </div>

        <a href="/funcionarios/cadastrar" class="inline-flex items-center justify-center gap-2 bg-primary text-white rounded-full
            px-6 py-3 font-medium whitespace-nowrap hover:scale-105 transition-transform duration-300">
            <span class="text-2xl leading-none">+</span>
            <span>Cadastrar</span>
        </a>
    </div>

    <div class="w-full border border-gray-300 rounded-2xl overflow-hidden">

        <% if (funcionarios.length === 0) { %>

            <p class="text-center text-gray-500 py-10">
                Nenhum funcionário cadastrado.
            </p>

        <% } else { %>

            <% funcionarios.forEach((funcionario, index) => { %>

                <div class="px-5 py-5">

                    <%- include("../partials/cardFuncionarios", {
                        element: funcionario
                    }) %>

                </div>

                <% if (index < funcionarios.length - 1) { %>
                    <div class="mx-5 border-b border-gray-200"></div>
                <% } %>

            <% }); %>

        <% } %>

    </div>
</section>
