<section class="w-full max-w-[1100px] mx-auto px-4 py-6">
    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-gray-900">
            Cadastrar funcionário
        </h1>

        <p class="text-gray-600 mt-1">
            Preencha as informações do novo funcionário
        </p>
    </div>

    <form action="/funcionarios/cadastrar" method="POST" class="w-full border border-gray-300 rounded-2xl p-6 flex flex-col gap-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="flex flex-col gap-2">
                <label for="nome" class="font-medium text-gray-800">
                    Nome
                </label>
                <input type="text" id="nome" name="nome" required maxlength="100"
                    class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-orange-400"/>
            </div>

            <div class="flex flex-col gap-2">
                <label for="email" class="font-medium text-gray-800">
                    E-mail
                </label>
                <input type="email" id="email" name="email"
                    class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-orange-400"/>
            </div>

            <div class="flex flex-col gap-2">
                <label for="telefone" class="font-medium text-gray-800">
                    Telefone
                </label>
                <input type="tel" id="telefone" name="telefone"
                    class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-orange-400"/>
            </div>

            <div class="flex flex-col gap-2">
                <label for="senha" class="font-medium text-gray-800">
                    Senha
                </label>
                <input type="password" id="senha" name="senha" required minlength="8"
                    class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-orange-400"/>
            </div>

            <div class="flex flex-col gap-2 md:col-span-2">
                <label for="permissao" class="font-medium text-gray-800">
                    Permissão
                </label>
                <select id="permissao" name="permissao" required class="w-full border border-gray-300 rounded-xl
                    px-4 py-3 bg-white outline-none focus:border-orange-400">
                    <option value="" disabled selected>
                        Selecione uma permissão
                    </option>
                    <option value="funcionario">Funcionário</option>
                    <option value="admin">Administrador</option>
                </select>
            </div>

        </div>

        <div class="flex justify-end gap-3 mt-4">

            <a href="/funcionarios" class="px-6 py-3 rounded-full border border-gray-300 text-gray-700 hover:bg-gray-100 transition-colors">
                Cancelar
            </a>

            <button type="submit" class="px-6 py-3 rounded-full bg-primary text-white font-medium hover:scale-105 transition-transform duration-300">
                Cadastrar funcionário
            </button>
        </div>
    </form>

</section>
