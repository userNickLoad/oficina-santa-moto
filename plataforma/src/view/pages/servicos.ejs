<%
const ops = [
    {
        href: "/registrar-servico",
        src: "/assets/registro.png",
        name: "Registrar Serviço"
    },
    {
        href: "/concluir-servico",
        src: "/assets/concluir-servico.png",
        name: "Concluir Serviço"
    }
];
%>

<section class="flex flex-col justify-center items-center">

    <div class="flex mt-[2vh] w-full">
        <h2 class="border-b border-gray px-[1vw]">
            Gerenciamento de Serviços
            <br>
            Selecione uma funcionalidade para continuar
        </h2>
    </div>

    <nav
        aria-label="Opções de serviços"
        class="grid grid-cols-2 gap-[2vw] my-[5vh]"
    >
        <% ops.forEach(item => { %>
            <%- include("../partials/card", item) %>
        <% }); %>
    </nav>

    <div class="w-full max-w-[900px] px-3 mb-10">

        <h2 class="text-xl mb-1">
            Ordens de serviço
        </h2>

        <p class="text-[16px] text-gray-500 font-normal leading-6">
            Acompanhe todas as ordens de serviço cadastradas
        </p>

        <div class="flex flex-wrap gap-3 mt-5">

            <button type="button" data-filtro="TODOS" class="filtro-os border border-gray-300 rounded-full px-4 py-2">
                Todos
            </button>

            <button type="button" data-filtro="EM_ANDAMENTO" class="filtro-os border border-gray-300 rounded-full px-4 py-2">
                Em andamento
            </button>

            <button type="button" data-filtro="CONCLUIDO" class="filtro-os border border-gray-300 rounded-full px-4 py-2">
                Concluídos
            </button>

            <button type="button" data-filtro="CANCELADO" class="filtro-os border border-gray-300 rounded-full px-4 py-2">
                Cancelados
            </button>

        </div>

        <div id="lista-todas-os" class="grid md:grid-cols-2 gap-4 mt-6">
            <p class="text-gray-500">
                Carregando ordens de serviço...
            </p>
        </div>

    </div>
</section>
<script src="/js/listarServicos.js" defer></script>
