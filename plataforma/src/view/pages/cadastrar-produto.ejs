<section class="flex flex-col w-full items-center">
    <h1 class="my-[2vh] text-lg w-full">
        Entrada no estoque
    </h1>

    <%- include("../partials/cadastrar/form", {
        form: {
            id: "form-cadastrar-produto",
            action: "/api/produto",
            method: "post",
            elements: [
                {type: "input", input: {name: "Nome do produto", type: "text", title: "Nome do produto", maxlength: 50, placeholder: "ex: Óleo de motor 10W-30", text_size: "text-md", size: "w-full"}},
                {
                    type: "hidden_container", 
                    container: {
                        id: "categoria",
                        title: {
                            text: "Categoria",
                            text_size: "text-lg"
                        },
                        elements: [
                            {   
                                type: "container",
                                container: {
                                    id: "categoria-opçoes",
                                    elements: [
                                        {
                                            type: "button", 
                                            button: {
                                                type: "simple", 
                                                name: "adicionar-categoria", 
                                                id: "adicionar-categoria", 
                                                content: "associar",
                                                size: "w-[40%]"
                                            }
                                        },
                                        {
                                            type: "button", 
                                            button: {
                                                type: "href", 
                                                name: "adicionar-categoria", 
                                                id: "adicionar-categoria", 
                                                content: "cadastrar novo",
                                                href: "/cadastrar-categoria",
                                                size: "w-[40%]"
                                            }
                                        }
                                    ]
                                }
        
                            },
                            {type: "input", input: {name: "Categoria", type: "text", maxlength: 50, placeholder: "ex: bateria, óleo, pneu, ect..", text_size: "text-md", size: "w-full"}}
                        ]
                    }
                },
                {
                    type: "hidden_container", 
                    container: {
                        id: "marca",
                        title: {
                            text: "Marca",
                            text_size: "text-lg"
                        },
                        elements: [
                            {   
                                type: "container",
                                container: {
                                    id: "marca-opçoes",
                                    elements: [
                                        {
                                            type: "button", 
                                            button: {
                                                type: "simple", 
                                                name: "adicionar-marca", 
                                                id: "adicionar-marca", 
                                                content: "associar",
                                                size: "w-[40%]"
                                            }
                                        },
                                        {
                                            type: "button", 
                                            button: {
                                                type: "href", 
                                                name: "cadastrar-marca", 
                                                id: "cadastrar-marca", 
                                                content: "cadastrar nova",
                                                href: "/cadastrar-marca",
                                                size: "w-[40%]"
                                            }
                                        }
                                    ]
                                }
        
                            },
                            {type: "button", button: {type: "simple", name: "adicionar-marca", id: "adicionar-marca", content: "+ adicionar marca"}},
                            {type: "input", input: {name: "Marca", type: "text", maxlength: 50, placeholder: "ex: honda", text_size: "text-md", size: "w-full"}}
                        ]
                    }
                },
                {
                    type: "container",
                    container: {
                        id: "row",
                        elements: [
                            
                            {type: "input", input: {title: "Quantidade", name: "quantidade", type: "number", maxlength: 50, placeholder: "1", text_size: "text-md", size: "w-[40%]" /*, size: "lg:w-[25vw] w-[40vw]"*/}},
                            {type: "input", input: {title: "Preço", name: "preço", maxlength: 50, placeholder: "R$ 0,00", text_size: "text-md", mask: "currency", size: "w-[40%]" /*, size: "lg:w-[25vw] w-[40vw]"*/}}
                        ]
                    }
                },
                {
                    type: "input", 
                    input: {title: "Descricao", name: "descricao", id: "descricao", type: "textarea", maxlength: "250", placeholder: "Escreva a descrição do produto", text_size: "text-md"}
                }
            ],
            buttons: [
                {
                    type: "submit",
                    id: "submit",
                    name: "submit",
                    content: "Cadastrar protudo",
                    svg: { path: "save-icon"}
                },

                {
                    type: "href",
                    id: "clear",
                    name: "clear",
                    content: "Limpar campos",
                    href: "/cadastrar-produto"
                }
            ]
        }
    }) %>
</section>

<script src="/js/currencyMask.js"></script>