<section class="flex flex-col w-full items-center">
    <h1 class="my-[2vh] text-lg">
        Cadastrando categoria de produtos
    </h1>

    <%- include("../partials/cadastrar/form", {
        form: {
            id: "form-cadastrar-categoria",
            action: "/api/categoria",
            method: "post",
            elements: [
                {type: "input", input: {title: "Nome da categoria",  name: "nome", type: "text", maxlength: 50, placeholder: "ex: óleo, escapamento, capacete etc..."}},
                {
                    type: "addble_container",
                    container: {
                        id: "atributos",
                        title: "Atributos",
                        elements: []
                    }
                },
                {
                    type: "input", 
                    input: {title: "Descricao", name: "descricao", id: "descricao", type: "textarea", maxlength: "250", placeholder: "Escreva a descrição da categoria (opcional)"}
                }
            ],
            buttons: [  
                {
                    submit: true, 
                    id: "submit", 
                    name: "submit", 
                    content: "salvar categoria",
                    svg: { path: "save-icon"}
                }
            ]
        }
    }) %>
</section>

<script src="/js/currencyMask.js"></script>