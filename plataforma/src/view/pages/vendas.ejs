<section class="flex flex-col w-full max-w-[1100px] mx-auto py-8 gap-8">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">Gerenciamento de Vendas</h2>
        <p class="text-gray-500 mt-1">Acompanhe e registre as vendas da oficina</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="bg-gray-100 rounded-[20px] p-6">
            <div class="flex items-center justify-between">
                <p class="text-gray-600">Total vendido</p>
                <img src="/assets/wallet.png" alt="" class="w-7 h-7">
            </div>
            <p id="total-vendas" class="text-3xl font-bold text-gray-800 mt-3">
                <%= innerContent.totalVendido.toLocaleString("pt-BR", { style: "currency", currency: "BRL" }) %>
            </p>
            <p class="text-sm text-gray-500 mt-2">Vendas registradas</p>
        </div>

        <div class="bg-gray-100 rounded-[20px] p-6">
            <div class="flex items-center justify-between">
                <p class="text-gray-600">Quantidade</p>
                <img src="/assets/parcel.png" alt="" class="w-7 h-7">
            </div>
            <p id="quantidade-vendas" class="text-3xl font-bold text-gray-800 mt-3">
                <%= innerContent.quantidadeVendas %>
            </p>
            <p class="text-sm text-gray-500 mt-2">Vendas realizadas</p>
        </div>
    </div>

    <div class="flex flex-col gap-5">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h3 class="text-xl font-semibold text-gray-800">Vendas recentes</h3>
            <button type="button" id="abrir-modal-venda"
                class="bg-primary rounded-full px-6 py-3 font-semibold flex items-center gap-2 hover:shadow-md hover:-translate-y-1 transition-all duration-200">
                <span class="text-lg">+</span>
                Nova Venda
            </button>
        </div>

        <div id="lista-vendas" class="border border-gray-200 rounded-[20px] min-h-[180px] p-6">
            <% if (innerContent.vendasRecentes.length === 0) { %>
                <div class="flex flex-col items-center justify-center text-center min-h-[130px] gap-3">
                    <img src="/assets/quotation.png" alt="" class="w-9 h-9">
                    <p class="font-semibold text-gray-700">Nenhuma venda registrada</p>
                    <p class="text-sm text-gray-500">As vendas realizadas aparecerão aqui.</p>
                </div>
            <% } else { %>
                <div class="flex flex-col divide-y divide-gray-200">
                    <% innerContent.vendasRecentes.forEach((venda) => { %>
                        <div class="flex flex-col gap-3 py-4">
                            <div class="flex flex-wrap items-center justify-between gap-4">
                                <div>
                                    <p class="font-semibold text-gray-800">Venda #<%= venda.id %></p>
                                    <p class="text-sm text-gray-500"><%= venda.cliente %></p>
                                    <p class="text-xs text-gray-400 mt-1">
                                        <%= new Date(venda.data).toLocaleDateString("pt-BR") %>
                                    </p>
                                </div>
                                <p class="font-semibold text-gray-800">
                                    <%= venda.total.toLocaleString("pt-BR", { style: "currency", currency: "BRL" }) %>
                                </p>
                            </div>

                            <div class="flex flex-col gap-2 pl-3 border-l-2 border-gray-200">
                                <% venda.produtos.forEach((produto) => { %>
                                    <div class="flex items-center justify-between gap-3 text-sm">
                                        <p class="text-gray-600">
                                            <%= produto.quantidade %>x <%= produto.nome %>
                                        </p>
                                        <p class="text-gray-500">
                                            <%= (produto.preco * produto.quantidade).toLocaleString("pt-BR", { style: "currency", currency: "BRL" }) %>
                                        </p>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </div>

    <div class="flex justify-center mt-5">
        <a href="/vendas/historico" class="inline-flex items-center justify-center border border-gray-300 rounded-full px-6 py-3 font-semibold text-gray-700 hover:bg-gray-100 hover:shadow-md
            transition-all duration-200">
            Ver todas as vendas
        </a>
    </div>    
</section>

<div id="modal-venda" class="hidden fixed inset-0 z-50">
    <div id="fundo-modal-venda" class="absolute inset-0 bg-black/40"></div>

    <div class="absolute right-0 top-0 h-full w-full sm:max-w-[500px] bg-white shadow-2xl flex flex-col">
        <div class="flex items-start justify-between border-b border-gray-200 p-6">
            <div>
                <h2 class="text-xl font-semibold text-gray-800">Nova Venda</h2>
                <p class="text-sm text-gray-500 mt-1">Selecione os produtos para registrar a venda</p>
            </div>
            <button type="button" id="fechar-modal-venda"
                class="text-gray-500 hover:text-gray-800 text-2xl leading-none">&times;</button>
        </div>

        <form id="form-registrar-venda" class="flex flex-col flex-1 min-h-0">
            <div class="flex-1 overflow-y-auto p-6 flex flex-col gap-6">
                <div class="flex flex-col gap-2 w-full">
                    <label for="buscar-cliente" class="text-sm font-medium text-gray-700">Cliente (opcional)</label>
                    <input type="text" id="buscar-cliente" autocomplete="off"
                        placeholder="Digite o nome do cliente"
                        class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-gray-500">
                    <div id="resultado-busca-cliente"
                        class="hidden border border-gray-200 rounded-xl bg-white max-h-[180px] overflow-y-auto"></div>
                    <div id="cliente-selecionado"
                        class="hidden bg-gray-100 rounded-xl p-3 items-center justify-between gap-3">
                        <span id="nome-cliente-selecionado" class="text-sm font-medium text-gray-800"></span>
                        <button type="button" id="remover-cliente"
                            class="text-sm text-red-600 hover:underline">Remover</button>
                    </div>
                </div>

                <div>
                    <label for="buscar-produto" class="block text-sm font-medium text-gray-700 mb-2">
                        Buscar produto
                    </label>
                    <input type="text" id="buscar-produto" placeholder="Digite o nome do produto"
                        class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-gray-500">
                    <div id="resultado-busca"
                        class="hidden mt-2 border border-gray-200 rounded-xl bg-white max-h-[200px] overflow-y-auto"></div>
                </div>

                <div class="flex flex-col gap-3">
                    <h3 class="font-semibold text-gray-800">Produtos selecionados</h3>
                    <div id="produtos-selecionados" class="flex flex-col gap-3">
                        <p class="text-sm text-gray-400 text-center py-8">Nenhum produto adicionado</p>
                    </div>
                </div>
            </div>

            <div class="border-t border-gray-200 p-6 flex flex-col gap-4">
                <div class="flex items-center justify-between">
                    <p class="font-medium text-gray-700">Total da venda</p>
                    <p id="total-venda" class="text-2xl font-bold text-gray-800">R$ 0,00</p>
                </div>
                <div class="flex gap-3">
                    <button type="button" id="cancelar-modal-venda"
                        class="flex-1 border border-gray-300 rounded-full px-5 py-3 font-semibold text-gray-700 hover:bg-gray-100 transition">
                        Cancelar
                    </button>
                    <button type="submit"
                        class="flex-1 bg-primary rounded-full px-5 py-3 font-semibold hover:shadow-md transition">
                        Registrar Venda
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="toast-sucesso"
    class="hidden fixed top-6 right-6 z-[60] bg-green-600 text-white px-6 py-4 rounded-xl shadow-lg">
    <p id="mensagem-sucesso"></p>
</div>

<script>
    const modalVenda = document.getElementById("modal-venda");
    const abrirModal = document.getElementById("abrir-modal-venda");
    const fecharModal = document.getElementById("fechar-modal-venda");
    const cancelarModal = document.getElementById("cancelar-modal-venda");
    const fundoModal = document.getElementById("fundo-modal-venda");

    function abrirModalVenda() {
        modalVenda.classList.remove("hidden");
        document.body.style.overflow = "hidden";
    }

    function fecharModalVenda() {
        modalVenda.classList.add("hidden");
        document.body.style.overflow = "";
    }

    abrirModal.addEventListener("click", abrirModalVenda);
    fecharModal.addEventListener("click", fecharModalVenda);
    cancelarModal.addEventListener("click", fecharModalVenda);
    fundoModal.addEventListener("click", fecharModalVenda);

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modalVenda.classList.contains("hidden")) {
            fecharModalVenda();
        }
    });
</script>

<script src="/js/vendas.js"></script>
