
<%
    const p = innerContent.produto;

    const imagens = p.imagens ?? [];
    const prateleiras = p.prateleiras ?? [];
    const atributos = p.atributos ?? {};

    const qtdAlocada = prateleiras.reduce(
        (total, item) => total + Number(item.quantidade ?? 0),
        0
    );

    const qtdNaoAlocada = Number(p.qtd_disponivel ?? 0) - qtdAlocada;

    const preco = Number(p.preco_venda ?? 0).toLocaleString("pt-BR", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });

    const atributosJson = (p.categoria)? JSON.stringify({categoria: p.categoria.nome, atributos: atributos}): "";

    const categoria = p.categoria ?? null

    const categoriaNome = (categoria)? categoria.nome : ""
    const categoriaId = (categoria)? categoria.id : ""

    const marca = (p.marca)? p.marca: null

    const marcaNome = (marca)? marca.nome: ""
    const marcaId = (marca)? marca.id : ""

    console.log(p)
%>

<section class="w-full flex flex-col items-center px-[3vw] py-[2vh]">
    <div class="w-full lg:w-[50vw] flex flex-col gap-[2vh]">

        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-xl font-bold">Editar produto</h1>
                <p class="text-sm text-gray-500">Atualize as informações do produto</p>
            </div>
        </div>

        <form
            id="form-editar-produto"
            action="/api/produto/<%= p.id %>/editar"
            method="post"
            enctype="multipart/form-data"
            class="flex flex-col gap-[2vh] w-full"
        >
            <!-- Nome -->
            <div class="flex flex-col gap-1" data-parent="inputbox">
                <label for="nome" class="font-medium">Nome do produto</label>
                <input
                    id="nome"
                    name="nome"
                    type="text"
                    maxlength="50"
                    required
                    value="<%= p.nome ?? '' %>"
                    placeholder="ex: Óleo de motor 10W-30"
                    class="border border-gray-300 rounded-xl p-3 focus:outline-2 focus:outline-gray-400"
                >
                <p id="output-nome" class="text-red-900 min-h-[2vh]"></p>
            </div>

            
            <!-- Categoria -->
            <section class="border border-gray-300 rounded-2xl p-4 flex flex-col gap-3"
                data-categoria="<%= atributosJson %>"
                >
                <%- include("../partials/inputBox", { item: {title: "Nome da categoria", subtitte: "Campo opcional, mas útil para organizar e localizar produtos.", name: "categoria", id: "categoria", type: "search", maxlength: 50, placeholder: "ex: bateria, óleo, pneu, ect..", text_size: "text-md", size: "w-full", value: categoriaNome, valueHidden: categoriaId}}) %>
                <%- include("../partials/cadastrar/addbleContainer", {container: {
                                    id: "atributos",
                                    title: "Atributos",
                                    mask: "./addbleMaskInputVeiculo",
                                    button: false,
                                    elements: [
                                        {type: "input", input: {title: "Abacate", id: "atributo", name: "atributo", maxlength: "20"}},
                                    ]

                                }}) %>
            </section>

            <!-- Marca -->
            <section class="border border-gray-300 rounded-2xl p-4 flex flex-col gap-3">
                <%- include("../partials/inputBox", {item: {title: "Marca", subtitte: "Campo opcional, mas útil para organizar e localizar produtos.", name: "marca", id: "marca", type: "search", maxlength: 50, placeholder: "ex: bateria, óleo, pneu, ect..", text_size: "text-md", size: "w-full", value: marcaNome, valueHidden: marcaId}}) %>
            </section>

            <!-- Estoque e preço -->
            <section class="border border-gray-300 rounded-2xl p-4 flex flex-col gap-3">
                <h2 class="font-bold text-lg">Estoque e preço</h2>

                <div class="grid grid-cols-2 gap-3">
                    <div class="flex flex-col gap-1" data-parent="inputbox">
                        <label for="preco" class="font-medium">Preço</label>
                        <input
                            id="preco"
                            name="preco"
                            type="text"
                            data-mask="currency"
                            inputmode="numeric"
                            value="R$ <%= preco %>"
                            class="border border-gray-300 rounded-xl p-3 w-full"
                        >
                        <p id="output-preco" class="text-red-900 min-h-[2vh]"></p>
                    </div>

                    <div class="flex flex-col gap-1" data-parent="inputbox">
                        <label for="alerta_quantidade" class="font-medium">Alerta de quantidade</label>
                        <input
                            id="alerta_quantidade"
                            name="alerta_quantidade"
                            type="number"
                            min="0"
                            step="1"
                            value="<%= p.alerta_quantidade ?? 0 %>"
                            class="border border-gray-300 rounded-xl p-3"
                        >
                        <p id="output-alerta_quantidade" class="text-red-900 min-h-[2vh]"></p>
                    </div>
                </div>



                <p class="text-sm text-gray-500">
                    Quantidade atualmente alocada em prateleiras:
                    <strong><%= qtdAlocada %></strong>
                </p>
            </section>

            <!-- Prateleiras existentes -->

            <!-- Descrição -->
            <div class="flex flex-col gap-1" data-parent="inputbox">
                <label for="descricao" class="font-medium">Descrição</label>
                <textarea
                    id="descricao"
                    name="descricao"
                    maxlength="250"
                    rows="5"
                    placeholder="Escreva a descrição do produto"
                    class="border border-gray-300 rounded-xl p-3 resize-none"
                ><%= p.descricao ?? '' %></textarea>
                <p id="output-descricao" class="text-red-900 min-h-[2vh]"></p>
            </div>

            <!-- Imagens atuais -->
            <section class="border border-gray-300 rounded-2xl p-4 flex flex-col gap-3">
                <div>
                    <h2 class="font-bold text-lg">Imagens do produto</h2>
                    <p class="text-sm text-gray-500">
                        As imagens atuais são mantidas, a menos que você marque alguma para remoção.
                    </p>
                </div>

                <% if (imagens.length > 0) { %>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                        <% imagens.forEach((imagem, index) => { %>
                            <label class="relative flex flex-col gap-2 border border-gray-200 rounded-xl p-2 cursor-pointer">
                                <img
                                    src="/files/<%= encodeURIComponent(imagem.caminho) %>"
                                    alt="Imagem <%= index + 1 %> de <%= p.nome %>"
                                    class="w-full aspect-square object-cover rounded-lg"
                                    loading="lazy"
                                >

                                <span class="flex items-center gap-2 text-sm">
                                    <input
                                        type="checkbox"
                                        name="images[<%= index %>][remove]"
                                        value="<%= imagem.id %>"
                                        data-ignore="true"
                                    >
                                    Remover imagem
                                </span>
                            </label>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-sm text-gray-500">Este produto ainda não possui imagens.</p>
                <% } %>

                <%- include("../partials/inputBox", {item: {type: "image", id: "img-produto", name: "imagem", tile: "Imagem do produto", placeholder: "Arraste uma imagem do produto ou clique para escolher"}}) %>
            </section>

            <p id="error" class="text-red-900 min-h-[2vh]"></p>

            <div class="flex flex-col gap-3">
                <button
                    id="submit"
                    type="submit"
                    class="w-full rounded-full bg-primary py-3 font-bold hover:opacity-90 transition"
                >
                    Salvar alterações
                </button>

                <a
                    href="/estoque/produto/<%= p.id %>"
                    class="w-full text-center border border-gray-400 rounded-full py-3 hover:bg-gray-100"
                >
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</section>

<script type="module" src="/js/editarProduto.js"></script>
<script src="/js/currencyMask.js"></script>
<script src="/js/inputFile.js"></script>
