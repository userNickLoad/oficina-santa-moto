<%
    const {clientes = []} = innerContent

%>

<section class="flex flex-col w-full items-center">
    <h1 class="my-[2vh] text-lg w-full">
        Gerenciar clientes
    </h1>
    <div
        class="w-full flex lg:flex-row flex-col  justify-between gap-[3vh]"
        >
        <div
            class="w-full"
            >
            <%- include("../partials/searchBar", {
                search: {
                    id: "client",
                    name: "client",
                    placeholder: "Coloque o nome do cliente"
                }

            }) %>
        </div>

        <div
            class="flex justify-center items-center"
            >
            <a 
                href="/clientes/cadastrar"
                class="lg:flex hidden justify-center items-center h-[80%] aspect-square 
                    bg-green-400 text-5xl rounded-2xl text-white
                    hover:scale-105 transition-transform duration-300"
                >
                +               
            </a>

            <%- include("../partials/button", {button: {id: "cadastrar-cliente", type: "href", content: "+ cadastrar", href: "/clientes/cadastrar", size: "min-w px-[10vw] bg-primary border-none lg:hidden"}}) %>

        </div>

    </div>
</section>


<section
    class="flex flex-col w-full items-center"
    >
    <h1 class="my-[2vh] text-lg w-full">
        Clientes cadastrados
    </h1>

    <div
        class="w-full flex flex-col gap-[2vh] items-center"
        >
        <% clientes.forEach(cliente => {%>
            <%- include("../partials/cardCliente", {element: cliente}) %>
        <% }); %>
    </div>

</section>

<script type="module" src="/js/clientes.js"></script>