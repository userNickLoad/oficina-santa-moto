<section class="flex flex-col w-full max-w-[1100px] mx-auto py-8 gap-8">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">
            Histórico de Vendas
        </h2>

        <p class="text-gray-500 mt-1">
            Consulte todas as vendas realizadas na oficina
        </p>
    </div>

    <form action="/vendas/historico" method="GET" class="border border-gray-200 rounded-[20px] p-6 flex flex-col gap-5">

        <h3 class="font-semibold text-gray-800">
            Filtrar vendas
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label for="filtro-cliente" class="block text-sm font-medium text-gray-700 mb-2">
                    Cliente
                </label>

                <input type="text" id="filtro-cliente" name="cliente" placeholder="Nome do cliente" value="<%= innerContent.filtros.cliente || '' %>"
                    class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-gray-500">
            </div>

            <div>
                <label for="data-inicial" class="block text-sm font-medium text-gray-700 mb-2">
                    Data inicial
                </label>

                <input type="date" id="data-inicial" autocomplete="off" name="dataInicial" 
                    class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-gray-500" value="<%= innerContent.filtros.dataInicial || '' %>">
            </div>

            <div>
                <label for="data-final" class="block text-sm font-medium text-gray-700 mb-2">
                    Data final
                </label>

                <input type="date" id="data-final" autocomplete="off" name="dataFinal" 
                    class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-gray-500" value="<%= innerContent.filtros.dataFinal || '' %>">
            </div>
        </div>

        <div class="flex flex-wrap justify-end gap-3">

            <a href="/vendas/historico?cliente=&dataInicial=&dataFinal=" id="limpar-filtros" class="border border-gray-300 rounded-full px-6 py-3 font-semibold text-gray-700 hover:bg-gray-100 transition">
                Limpar filtros
            </a>

            <button type="submit" class="bg-primary rounded-full px-6 py-3 font-semibold hover:shadow-md transition">
                Filtrar vendas
            </button>
        </div>
    </form>

    <div class="border border-gray-200 rounded-[20px] p-6">

        <% if (innerContent.vendas.length === 0) { %>

            <div class="flex flex-col items-center justify-center text-center min-h-[180px] gap-3">

                <img src="/assets/quotation.png" alt="" class="w-9 h-9">

                <p class="font-semibold text-gray-700">
                    Nenhuma venda registrada
                </p>

                <p class="text-sm text-gray-500">
                    As vendas realizadas aparecerão aqui.
                </p>
            </div>
        <% } else { %>

            <div class="flex flex-col divide-y divide-gray-200">

                <% innerContent.vendas.forEach((venda) => { %>

                    <div class="flex flex-col gap-3 py-5">

                        <div class="flex flex-wrap items-center justify-between gap-4">

                            <div>
                                <p class="font-semibold text-gray-800">
                                    Venda #<%= venda.id %>
                                </p>
                
                                <p class="text-sm text-gray-500">
                                    <%= venda.cliente %>
                                </p>

                                <p class="text-xs text-gray-400 mt-1">
                                    <%= new Date(venda.data).toLocaleDateString("pt-BR") %>
                                </p>
                            </div>
                        </div>

                        <div class="flex flex-col gap-2 pl-3 border-l-2 border-gray-200">

                            <% venda.produtos.forEach((produto) => { %>

                                <div class="flex items-center justify-between gap-3 text-sm">

                                    <p class="text-gray-600">
                                        <%= produto.quantidade %>x <%= produto.nome %>
                                    </p>

                                    <p class="text-gray-500">
                                        <%= (produto.preco * produto.quantidade).toLocaleString("pt-BR", {
                                            style: "currency",
                                            currency: "BRL"
                                        }) %>
                                    </p>
                                </div>
                            <% }); %>

                            <div class="flex items-center justify-end gap-4 mt-1">
                                <p class="font-semibold text-gray-800">
                                    Total: <%= venda.total.toLocaleString("pt-BR", { style: "currency", currency: "BRL"}) %>
                                </p>
                                <button type="button" class="excluir-venda inline-flex items-center justify-center gap-2 text-sm text-red-600 hover:text-red-800 transition"
                                    data-id="<%= venda.id %>">
                                    <img src="/assets/trash-bin.png" alt="" class="w-4 h-4">
                                    <span>Excluir</span>
                                </button>   
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</section>

<div id="toast-sucesso"
     class="hidden fixed top-6 right-6 z-[60] bg-green-600 text-white px-6 py-4 rounded-xl shadow-lg">
    <p id="mensagem-sucesso"></p>
</div>

<script>

    let tempoToast;

    function mostrarSucesso(mensagem) {
        const toast = document.getElementById("toast-sucesso");
        const texto = document.getElementById("mensagem-sucesso");

        texto.textContent = mensagem;
        toast.classList.remove("hidden");

        clearTimeout(tempoToast);

        tempoToast = setTimeout(() => {
            toast.classList.add("hidden");
        }, 3000);
    }

    document.querySelectorAll(".excluir-venda").forEach((botao) => {
        botao.addEventListener("click", async () => {
            const idVenda = botao.dataset.id;

            const confirmar = confirm(
                `Deseja realmente excluir a venda #${idVenda}?\n\nOs produtos serão devolvidos ao estoque.`
            );

            if (!confirmar) return;

            botao.disabled = true;

            try {
                const resposta = await fetch(`/api/venda/${idVenda}`, {
                    method: "DELETE"
                });

                const resultado = await resposta.json();

                if (!resposta.ok) {
                    throw new Error(
                        resultado.mensagem || "Erro ao excluir venda."
                    );
                }

                mostrarSucesso(
                    resultado.mensagem || "Venda excluída com sucesso!"
                );

                setTimeout(() => {
                    window.location.reload();
                }, 3000);

            } catch (error) {
                alert(error.message || "Erro ao excluir venda.");
                botao.disabled = false;
            }
        });
    });

    document.getElementById("limpar-filtros").addEventListener("click", () => {
        event.preventDefault();

        document.getElementById("data-inicial").value = "";
        document.getElementById("data-final").value = "";
        document.getElementById("filtro-cliente").value = ""

        window.location.href="/vendas/historico?cliente=&dataInicial=&dataFinal=";
    }); 
</script>

