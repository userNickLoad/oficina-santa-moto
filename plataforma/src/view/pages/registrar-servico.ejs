<section class="flex flex-col items-center w-full py-6">

    <h2 class="text-xl w-full max-w-[500px] mb-6">
        Novo registro de ordem de serviço
    </h2>

    <p class="text-[16px] text-gray-500 font-normal leading-6">
        Preencha as informações abaixo
    </p>

    <%- include("../partials/cadastrar/form", {
        form: {
            id: "form-registrar-servico",
            action: "/api/servico",
            method: "post",
            size: "max-w-[500px] w-full",
            elements: [
                {
                    type: "input",
                    input: {
                        id: "nome_cliente",
                        name: "nome_cliente",
                        title: "Nome do cliente",
                        type: "text",
                        placeholder: "Digite o nome do cliente",
                        maxlength: 100
                    }
                },
                {
                    type: "input",
                    input: {
                        id: "telefone",
                        name: "telefone",
                        title: "Telefone",
                        type: "tel",
                        placeholder: "(11) 99999-9999",
                        maxlength: 20
                    }
                },
                {
                    type: "input",
                    input: {
                        id: "marca_moto",
                        name: "marca_moto",
                        title: "Marca da moto",
                        type: "text",
                        placeholder: "Selecione a marca",
                        maxlength: 100
                    }
                },
                {
                    type: "input",
                    input: {
                        id: "modelo_moto",
                        name: "modelo_moto",
                        title: "Modelo da moto",
                        type: "text",
                        placeholder: "Selecione o modelo",
                        maxlength: 20
                    }
                },
                {
                    type: "input",
                    input: {
                        id: "ano_moto",
                        name: "ano_moto",
                        title: "Ano da moto",
                        type: "number",
                        placeholder: "Ex: 2024"
                    }
                },
                {
                    type: "input",
                    input: {
                        id: "descricao",
                        name: "descricao",
                        title: "Descrição do serviço",
                        type: "textarea",
                        placeholder: "Descreva o serviço a ser realizado",
                        maxlength: 250
                    }
                },
                {
                    type: "input",
                    input: {
                        id: "preco",
                        name: "preco",
                        title: "Preço do serviço",
                        type: "number",
                        placeholder: "Ex: 150.00"
                    }
                },
                {
                    type: "input",
                    input: {
                        id: "data_entrada",
                        name: "data_entrada",
                        title: "Data de entrada",
                        type: "date"
                    }
                },
                {
                    type: "input",
                    input: {
                        id: "produto_estoque",
                        name: "produto_estoque",
                        title: "Produto do estoque (opcional)",
                        type: "text",
                        placeholder: "Pesquisar produto do estoque",
                        maxlength: 100
                    }
                },
                {
                    type: "input",
                    input: {
                        id: "quantidade_produto",
                        name: "quantidade_produto",
                        title: "Quantidade utilizada (opcional)",
                        type: "number",
                        placeholder: "Ex: 1"
                    }
                },
                {
                    type: "input",
                    input: {
                        id: "preco_produto",
                        name: "preco_produto",
                        title: "Preço unitário do produto (R$)",
                        type: "number",
                        placeholder: "Ex: 80.00"
                    }
                }
            ],
            buttons: [
                {
                    type: "submit",
                    id: "registrar",
                    name: "registrar",
                    content: "Registrar Serviço",
                    submit: true
                }
            ]
        }
    }) %>

</section>

<div id="sugestoes-clientes" 
    class="hidden bg-white border border-gray-200 rounded-xl shadow-sm max-h-48 overflow-y-auto">
</div>

<div class="w-full max-w-[550px] mx-auto px-3 mb-6">
    <button type="button" id="adicionar-produto" class="text-sm font-medium cursor-pointer">
        + Adicionar produto
    </button>
    <div id="lista-produtos" class="flex flex-col gap-2 mt-4"></div>
</div>

<script>
    document.getElementById("form-registrar-servico").addEventListener("submit", async function(event) {
    event.preventDefault();

    const campos = this.querySelectorAll(
        "#nome_cliente, #telefone, #marca_moto, #modelo_moto, #ano_moto, #descricao, #preco, #data_entrada"
    );

    const mensagemErro = document.getElementById("error");
    let possuiCampoVazio = false;

    campos.forEach(campo => {
        if (campo.value.trim() === "") {
            console.log("Campo vazio", campo.id);
            possuiCampoVazio = true;
        }
    });

    if (possuiCampoVazio) {
        mensagemErro.textContent = "Preencha todos os campos obrigatórios";
        return;
    }

    if (!clienteSelecionado) {
        mensagemErro.textContent = "Selecione um cliente já cadastrado";
        return;
    }

    if (!idModeloSelecionado) {
        mensagemErro.textContent = "Selecione um modelo de moto na lista";
        return;
    }

    const dados = {
        descricao: document.getElementById("descricao").value.trim(),
        preco: document.getElementById("preco").value,
        id_cliente: clienteSelecionado,
        id_modelo: idModeloSelecionado,
        ano: Number(document.getElementById("ano_moto").value),
        produtos: produtosAdicionados
    };

    try {
        mensagemErro.textContent = "";

        const resposta = await fetch("/api/servico", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(dados)
        });

        const resultado = await resposta.json();

        if (!resposta.ok) {
            mensagemErro.textContent = resultado.mensagem || "Erro ao registrar serviço";
            return;
        }

        alert("Serviço registrado com sucesso!");
        window.location.href = "/servicos";

    } catch (error) {
        console.error(error);
        mensagemErro.textContent = "Erro ao conectar com o servidor";
    }
    });
    const campoProdutoEstoque = document.getElementById("produto_estoque");
    const campoPrecoProduto = document.getElementById("preco_produto");

    let produtoSelecionado = null;
    const sugestoesProdutos = document.createElement("div");
    sugestoesProdutos.className = "hidden bg-white border border-gray-200 rounded-xl shadow-sm max-h-48 overflow-y-auto";

    campoProdutoEstoque.insertAdjacentElement("afterend", sugestoesProdutos);
    campoProdutoEstoque.setAttribute("autocomplete", "off");
    campoProdutoEstoque.addEventListener("input", async function () {
        produtoSelecionado = null;
        campoPrecoProduto.value = "";

        const nome = this.value.trim();
        sugestoesProdutos.innerHTML = "";

        if(nome.length < 2) {
            sugestoesProdutos.classList.add("hidden");
            return;
        }

        sugestoesProdutos.classList.remove("hidden");
        sugestoesProdutos.textContent = "Pesquisando produtos...";

        try{
            const resposta = await fetch(`/api/produto/buscar?nome=${encodeURIComponent(nome)}`);

            if(!resposta.ok){
                throw new Error("Erro ao pesquisar produtos");
            }

            const produtos = await resposta.json();

            if(campoProdutoEstoque.value.trim() !== nome) return;

            sugestoesProdutos.innerHTML = "";

            if(produtos.length === 0){
                sugestoesProdutos.textContent = "Produto não encontrado";
                return;
            }

            produtos.forEach(produto => {
                const opcao = document.createElement("button");

                opcao.type = "button";
                opcao.className = "block w-full text-left p-3 hover:bg-gray-100 cursor-pointer";

                opcao.textContent = `${produto.nome} - Estoque: ${produto.qtd_disponivel}`;

                opcao.addEventListener("click", () =>{
                    produtosSelecionado = produto;
                    campoProdutoEstoque.value = produto.nome;
                    campoPrecoProduto.value = Number(produto.preco_venda).toFixed(2);

                    sugestoesProdutos.classList.add("hidden");
                });

                sugestoesProdutos.appendChild(opcao);
            });
        }catch (error){
            console.error(error);
            sugestoesProdutos.textContent = "Erro ao pesquisar produtos";
        }
    });

    const produtosAdicionados = [];
    const botaoAdicionar = document.getElementById("adicionar-produto");
        const listaProdutos = document.getElementById("lista-produtos");

        botaoAdicionar.addEventListener("click", function(){
            const campoProduto = document.getElementById("produto_estoque");
            const campoQuantidade = document.getElementById("quantidade_produto");

            const produto = campoProduto.value.trim();
            const quantidade = Number(campoQuantidade.value);
            const preco = Number(doument.getElementById("preco_produto").value);
            const precoEmCentavos = Math.round(preco * 100);

            if (!produtoSelecionado || !Number.isInteger(quantidade) || quantidade <= 0 || quantidade > produtoSelecionado.qtd_disponivel ||
                !Number.isFinite(preco) || preco < 0 || Math.abs(preco * 100 - precoEmCentavos) > 0.000001) {
                alert("Selecione um produto e informe uma quantidade e um preço válidos.");
                return;
            }
            const produtoDuplicado = produtosAdicionados.some(
                item => item.id_produto === produtoSelecionado.id
            );

            if (produtoDuplicado) {
                alert("Este produto já foi adicionado ao serviço.");
                return;
            }
            const produtoAdicionado = {
                id_produto: produtoSelecionado.id,
                quantidade: quantidade,
                preco: (precoEmCentavos/100).toFixed(2)
            };
            produtosAdicionados.push(produtoAdicionado);
            const item = document.createElement("div");
            item.className = "flex items-center justify-between gap-3 border border-gray-200 rounded-xl p-3";

            const descricao = document.createElement("span");
            descricao.textContent = `${produto} - Quantidade: ${quantidade}`;
            const remover = document.createElement("button");
            remover.type = "button";
            remover.className = "text-red-600 cursor pointer";
            remover.textContent = "Remover";

            remover.addEventListener("click", () => { 
                const indice = produtosAdicionados.indexOf(produtoAdicionado);
                if (indice !== -1) {
                    produtosAdicionados.splice(indice, 1);
                }
                item.remove();
            });

            item.append(descricao, remover);
            listaProdutos.appendChild(item);

            campoProduto.value = "";
            campoQuantidade.value = "";
            campoPrecoProduto.value = "";
            produtosSelecionado = null;
        });
    const formulario = document.getElementById("form-registrar-servico");
    const blocoProdutos = document.getElementById("adicionar-produto").parentElement;
    const botaoRegistrar = document.getElementById("registrar");

    if(formulario && blocoProdutos && botaoRegistrar){
        botaoRegistrar.parentElement.before(blocoProdutos);
    }

    const campoNomeCliente = document.getElementById("nome_cliente");
    const sugestoesClientes = document.getElementById("sugestoes-clientes");
    let clienteSelecionado = null;
    campoNomeCliente.setAttribute("autocomplete", "off");
    campoNomeCliente.addEventListener("input", async function() {
        clienteSelecionado = null;

        const nome = this.value.trim();

        sugestoesClientes.innerHTML = "";

        if(nome.length < 2){
            sugestoesClientes.classList.add("hidden");
            return;
        }

        sugestoesClientes.classList.remove("hidden");
        sugestoesClientes.textContent = "Pesquisando clientes...";
        try{
            const resposta = await fetch(`/api/cliente/buscar?nome=${encodeURIComponent(nome)}`);

            if(!resposta.ok){
                throw new Error("Erro ao pesquisar clientes");
            }

            const clientes = await resposta.json();

            if(campoNomeCliente.value.trim() !== nome) return;

            sugestoesClientes.innerHTML = "";

            if(clientes.length === 0){
                sugestoesClientes.textContent = "Cliente não encontrado. Necessário cadastrá-lo.";
                return;
            }

            clientes.forEach(cliente => {
                const opcao = document.createElement("button");

                opcao.type = "button";
                opcao.className = "block w-full text-left p-3 hover:bg-gray-100 cursor-pointer";

                opcao.textContent = cliente.nome;

                opcao.addEventListener("click", () => {
                    clienteSelecionado = cliente.id;
                    campoNomeCliente.value = cliente.nome;

                    document.getElementById("telefone").value = cliente.telefone ?? "";

                    sugestoesClientes.classList.add("hidden");
                });

                sugestoesClientes.appendChild(opcao);
            });
        } catch(error){
            console.error(error);
            sugestoesClientes.textContent = "Não foi possível pesquisar clientes.";
        }
    });
    campoNomeCliente.insertAdjacentElement("afterend", sugestoesClientes);

    const campoMarcaMoto = document.getElementById("marca_moto");
    const campoModeloMoto = document.getElementById("modelo_moto");

    let idMarcaSelecionada = null;
    let idModeloSelecionado = null;

    const sugestoesMarca = document.createElement("div");
    const sugestoesModelos = document.createElement("div");

    const estiloSugestoes = "hidden bg-white border-gray-200 rounded-2xl shadow-sm max-h-48 overflow-y-auto";
    sugestoesMarca.className = estiloSugestoes;
    sugestoesModelos.className = estiloSugestoes;

    campoMarcaMoto.insertAdjacentElement("afterend", sugestoesMarca);
    campoModeloMoto.insertAdjacentElement("afterend", sugestoesModelos);

    campoMarcaMoto.setAttribute("autocomplete", "off");
    campoModeloMoto.setAttribute("autocomplete", "off");

    let marcaDisponiveis = [];

    async function carregarMarcas(){
        try{
            const resposta = await fetch("/api/moto/marcas");
            if(!resposta.ok) {
                throw new Error("Erro ao carregar marcas");
            }
            marcaDisponiveis = await resposta.json();
        }catch (error){
            console.error(error);
        }
    }
    
    carregarMarcas();

    campoMarcaMoto.addEventListener("input", function() {
        idMarcaSelecionada = null;
        idModeloSelecionado = null;

        campoModeloMoto.value = "";
        sugestoesModelos.classList.add("hidden");

        const pesquisa = this.value.trim().toLowerCase();

        sugestoesMarca.innerHTML = "";

        if(!pesquisa){
            sugestoesMarca.classList.add("hidden");
            return;
        }

        const marcas = marcaDisponiveis.filter(marca =>
            marca.nome.toLowerCase().includes(pesquisa)
        );

        sugestoesMarca.classList.remove("hidden");

        if(marcas.length === 0){
            sugestoesMarca.textContent = "Marca não encontrada";
            return;
        }

        marcas.forEach(marca => {
            const opcao = document.createElement("button");

            opcao.type = "button";
            opcao.className = "block w-full text-left p-3 hover:bg-gray-100 cursor-pointer";

            opcao.textContent = marca.nome;

            opcao.addEventListener("click", () => {
                idMarcaSelecionada = marca.id;
                campoMarcaMoto.value = marca.nome;
                sugestoesMarca.classList.add("hidden");
            });

            sugestoesMarca.appendChild(opcao);
        });
    });

    campoModeloMoto.addEventListener("input", async function (){
        idModeloSelecionado = null;

        const pesquisa = this.value.trim().toLowerCase();

        sugestoesModelos.innerHTML = "";
        if(!idMarcaSelecionada){
            sugestoesModelos.textContent = "Selecione uma marca primeiro";
            sugestoesModelos.classList.remove("hidden");
            return;
        }

        if(!pesquisa){
            sugestoesModelos.classList.add("hidden");
            return;
        }

        try{
            const resposta = await fetch(`/api/moto/modelos?marca=${idMarcaSelecionada}`);

            if(!resposta.ok){
                throw new Error("Error ao carregar modelos");
            }

            const modelos = await resposta.json();

            const encontrados = modelos.filter(modelo =>
                modelo.nome.toLowerCase().includes(pesquisa)
            );

            sugestoesModelos.classList.remove("hidden");

            if(encontrados.length === 0){
                sugestoesModelos.textContent = "Modelo não encontrado";
                return;
            }

            encontrados.forEach(modelo =>{
                const opcao = document.createElement("button");

                opcao.type = "button";
                opcao.className = "block w-full texte-left p-3 hover:bg-gray-100 cursor-pointer";
                opcao.textContent = modelo.nome;

                opcao.addEventListener("click", () => {
                    idModeloSelecionado = modelo.id;
                    campoModeloMoto.value = modelo.nome;
                    sugestoesModelos.classList.add("hidden");
                });

                sugestoesModelos.appendChild(opcao);
            });
        }catch (error){
            console.error(error);
            sugestoesModelos.textContent = "Erro ao pesquisar modelos";
            sugestoesModelos.classList.remove("hidden");
        }
    });
</script>
